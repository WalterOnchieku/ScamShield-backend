cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Secrets
.env
.env.*
!.env.example

# Local data and trained models
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
models/*
!models/.gitkeep

# Frontend
node_modules/
.next/
out/
dist/

# Editor and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
EOF